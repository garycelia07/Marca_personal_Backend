# --- App ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (Supabase Postgres) ---
# Tomar de: Supabase Dashboard > Project Settings > Database > Connection string (usar el "Connection pooling" para runtime y el directo para migraciones)
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres"

# --- Almacenamiento de archivos (PDFs/imágenes) ---
# Se guardan en disco, en el mismo VPS donde corre esta API (NO en Supabase Storage).
# Debe ser una carpeta persistente entre despliegues, fuera del repo git.
MATERIALS_UPLOAD_DIR=./uploads/materials
# Tamaño máximo por archivo subido (PDF o imagen), en MB.
MATERIALS_MAX_FILE_SIZE_MB=20

# --- Auth ---
JWT_SECRET=change-me-super-secreto
JWT_EXPIRES_IN=8h
ADMIN_SEED_EMAIL=admin@garymayhua.com
ADMIN_SEED_PASSWORD=CambiarEnProduccion123!
